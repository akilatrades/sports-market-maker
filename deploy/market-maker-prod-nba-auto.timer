[Unit]
Description=Disabled-by-default NBA production validation scans (not armed)

[Timer]
# Five-minute candidate scans. NBA worker itself requires a verified 2–6h window.
OnCalendar=*-*-* *:0/5:00 UTC
AccuracySec=10s
Persistent=false
Unit=market-maker-prod-nba-auto.service

[Install]
WantedBy=timers.target
