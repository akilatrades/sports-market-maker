[Unit]
Description=Disabled-by-default bounded Kalshi production NBA validation worker
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/sports-market-maker-prod-auto
EnvironmentFile=/etc/market-maker-prod-nba-auto.env
ExecStart=/home/trader/sports-market-maker-prod-auto/.venv/bin/python -m live.prod_nba_auto --live
Restart=no
UMask=0077
TimeoutStartSec=240
