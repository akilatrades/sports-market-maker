[Unit]
Description=Export the bots' orders, fills and settlements to the owner's PRIVATE GitHub repo
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/sports-market-maker-prod-auto
# Only the owner's fine-grained GitHub token for the private data repo.
# No Kalshi credentials: the export reads the bots' journals only.
EnvironmentFile=/etc/market-maker-private-export.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/trader/sports-market-maker-prod-auto/.venv/bin/python -m tools.export_private_fills --push
Nice=15
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Reads journals; can never change them or anything else under /home.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
